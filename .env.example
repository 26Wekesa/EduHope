# Copy to .env for local sandbox testing. Never commit your real .env.
SECRET_KEY=replace-with-a-long-random-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Docker Compose local PostgreSQL settings. Keep the password URL-safe.
POSTGRES_DB=eduhope
POSTGRES_USER=eduhope
POSTGRES_PASSWORD=replace-with-a-url-safe-local-password
# Container PostgreSQL is local and does not use TLS. Production defaults to requiring TLS.
DATABASE_SSL_REQUIRE=False
# Optional for local PostgreSQL; omit to use the local SQLite database.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/eduhope
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-sandbox-consumer-key
MPESA_CONSUMER_SECRET=your-sandbox-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-sandbox-passkey
# Must be a public HTTPS URL for Safaricom callbacks; localhost is not reachable by Daraja.
MPESA_CALLBACK_URL=https://your-public-domain.example/mpesa/callback/
# 174379 is the sandbox PayBill shortcode. Confirm the type for your assigned shortcode.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
